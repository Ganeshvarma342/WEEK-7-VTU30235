import java.util.*;

class MyHashSet {

    private static final int BUCKETS = 10000;
    private List<Integer>[] table;

    public MyHashSet() {
        table = new LinkedList[BUCKETS];
        for (int i = 0; i < BUCKETS; i++) {
            table[i] = new LinkedList<>();
        }
    }

    private int hash(int key) {
        return key % BUCKETS;
    }

    public void add(int key) {
        int idx = hash(key);
        if (!table[idx].contains(key)) {
            table[idx].add(key);
        }
    }

    public void remove(int key) {
        int idx = hash(key);
        table[idx].remove(Integer.valueOf(key)); // remove by value, not index
    }

    public boolean contains(int key) {
        return table[hash(key)].contains(key);
    }
}

